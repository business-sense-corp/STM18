<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="statement_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-size:12px;">

                    <!-- HEADER -->
                    <table style="width:100%; margin-bottom:15px;">
                        <tr>
                            <td style="width:70%;">
                                <t t-if="company.logo">
                                    <img t-att-src="image_data_uri(company.logo)"
                                        style="max-height:100px;" />
                                </t>
                                <br />
                                <div>
                                    <strong>
                                        <span t-field="company.name" />
                                    </strong>
                                </div>
                                <div>
                                    <span t-field="company.street" />
                                </div>
                                <div>
                                    <span t-field="company.city" />
                                </div>
                                <div>
                                    <strong>Phone:</strong>
                                    <span t-field="company.phone" />
                                </div>

                                <!-- CUSTOMER -->
                                <t t-if="docs">
                                    <h3>Customer Information</h3>
                                    <div>
                                        <strong>Name:</strong>
                                        <span t-field="o.name" />
                                    </div>
                                    <div>
                                        <strong>Address:</strong>
                                        <span t-field="o.street" />
                                    </div>
                                    <div>
                                        <strong>Phone:</strong>
                                        <span t-field="o.phone" />
                                    </div>
                                    <div>
                                        <strong>Email:</strong>
                                        <span t-field="o.email" />
                                    </div>
                                </t>
                            </td>

                            <td style="width:30%;">
                                <h2 style="margin-bottom:5px;">Account Statement</h2>
                                <div>
                                    <strong>Date:</strong>
                                    <span t-esc="statement_date" />
                                </div>

                                <br />

                                <!-- PAYMENTS SUMMARY -->
                                <div>
                                    <strong>Collected Amount:</strong>
                                    <span t-esc="collected_amount" />
                                </div>
                                <div>
                                    <strong>Outstanding Amount:</strong>
                                    <span t-esc="outstanding_amount" />
                                </div>
                                <div>
                                    <strong>Total No of Cheques:</strong>
                                    <span t-esc="total_cheques" />
                                </div>
                                <div>
                                    <strong>Collected:</strong>
                                    <span t-esc="cheques_collected" />
                                </div>
                                <div>
                                    <strong>Rejected:</strong>
                                    <span t-esc="cheques_rejected" />
                                </div>
                                <div>
                                    <strong>Remaining:</strong>
                                    <span t-esc="cheques_remaining" />
                                </div>
                            </td>
                        </tr>
                    </table>


                    <!-- UNITS INFORMATION (NEW)   -->
                    <style>
                        .tbl {
                        width: 100%;
                        border-collapse: collapse;
                        font-size: 11px;
                        }
                        .tbl th {
                        background: #f7f7f7;
                        text-align: center;
                        padding: 6px;
                        border: 1px solid #cfcfcf;
                        font-weight: 700;
                        }
                        .tbl td {
                        padding: 6px;
                        border: 1px solid #cfcfcf;
                        vertical-align: middle;
                        }
                        .text-right { text-align: right; }
                        .text-center { text-align: center; }
                        .nowrap { white-space: nowrap; }

                        .section-title {
                        font-size: 12px;
                        font-weight: 700;
                        text-align: left;
                        padding: 6px 8px;
                        margin: 14px 0 6px 0;
                        border: 1px solid #cfcfcf;
                        background: #f2f2f2;
                        }
                        .muted {
                        color: #666;
                        font-weight: 400;
                        }
                        .empty-row {
                        text-align: center;
                        color: #666;
                        font-style: italic;
                        padding: 10px 0;
                        }
                        .unit-sep {
                        border-top: 1px dashed #cfcfcf;
                        margin: 10px 0 0 0;
                        }
                    </style>

                    <h3 style="margin-top:15px; text-align:center;">Units Information</h3>
                    <t t-if="units">
                        <table class="tbl" style="margin-top:10px; margin-bottom:12px;">
                            <thead>
                                <tr>
                                    <th class="nowrap">Unit Name</th>
                                    <th>Unit Category</th>
                                    <th class="nowrap">Unit Type</th>
                                    <th class="nowrap">Project</th>
                                    <th class="nowrap">Unit Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="units" t-as="u">
                                    <tr>
                                        <td class="nowrap">
                                            <span t-field="u['unit_product'].name" />
                                        </td>
                                        <td>
                                            <span t-field="u['unit_product'].categ_id" />
                                        </td>
                                        <td class="nowrap">
                                            <span t-field="u['unit_product'].project_type" />
                                        </td>
                                        <td class="nowrap">
                                            <span t-field="u['unit_product'].project_location" />
                                        </td>
                                        <td class="text-right nowrap">
                                            <span t-esc="u['unit_amount']" />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- (2) Assignments/Installments -->
                        <t t-foreach="units" t-as="u">
                            <div class="section-title"> Installments / Assignments - <span
                                    t-esc="u['unit_product'].name" />
                                <span class="muted"> (Count: <span
                                        t-esc="len(u['installments'])" />) </span>
                            </div>
                            <table class="tbl" style="margin-bottom:14px;">
                                <thead>
                                    <tr>
                                        <th class="nowrap">Payment Date</th>
                                        <th class="nowrap">Name</th>
                                        <th class="nowrap">Payment Journal</th>
                                        <th>Partner</th>
                                        <th class="nowrap">Payment Amount</th>
                                        <th class="nowrap">Due Date</th>
                                        <th class="nowrap">Installment No.</th>
                                        <th class="nowrap">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="u['installments']">
                                        <t t-foreach="u['installments']" t-as="l">
                                            <tr>
                                                <td class="nowrap">
                                                    <span
                                                        t-esc="l.payment_date.strftime('%d/%m/%Y') if l.payment_date else ''" />
                                                </td>
                                                <td class="nowrap">
                                                    <span t-field="l.name" />
                                                </td>
                                                <td class="nowrap">
                                                    <span
                                                        t-esc="l.journal_id.with_context(lang='en_US').name" />
                                                </td>
                                                <td class="nowrap">
                                                    <span t-field="l.partner_id" />
                                                </td>
                                                <td class="text-right nowrap">
                                                    <span t-field="l.payment_amount" />
                                                </td>
                                                <td class="nowrap">
                                                    <span
                                                        t-esc="l.due_date.strftime('%d/%m/%Y') if l.due_date else ''" />
                                                </td>
                                                <td class="text-center nowrap">
                                                    <span t-esc="l.installment_no" />
                                                </td>
                                                <td class="text-center nowrap">
                                                    <span t-esc="l.state" />
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-if="not u['installments']">
                                        <tr>
                                            <td colspan="8" class="empty-row">
                                                No assignments/installments found for this unit.
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div class="unit-sep"></div>
                        </t>
                    </t>
                    <t t-if="not units">
                        <p style="text-align:center; margin-top:20px; color:#666;">
                            No units found.
                        </p>
                    </t>
                </div>
            </t>
        </t>
    </template>

</odoo>