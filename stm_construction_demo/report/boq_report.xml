<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_construction_boq" model="ir.actions.report">
        <field name="name">تقرير المقايسة وبطاقة المشروع (PDF)</field>
        <field name="model">construction.boq</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stm_construction_demo.report_construction_boq_document</field>
        <field name="report_file">stm_construction_demo.report_construction_boq_document</field>
        <field name="print_report_name">'BOQ - %s' % (object.name or 'Draft')</field>
        <field name="binding_model_id" ref="model_construction_boq"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_construction_boq_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" dir="rtl" style="direction: rtl; text-align: right; font-family: 'DejaVu Sans', sans-serif; font-size: 11px; color: #1e293b;">
                        <!-- Header Banner -->
                        <div style="background: #0f2942; color: #ffffff; padding: 14px 18px; border-radius: 6px; margin-bottom: 14px; border-bottom: 4px solid #c99738;">
                            <table style="width: 100%; border-collapse: collapse; color: #ffffff;">
                                <tr>
                                    <td style="width: 70%; vertical-align: middle;">
                                        <div style="font-size: 11px; color: #e2c275; margin-bottom: 4px;">المقايسة وبطاقة المشروع التنفيذية (BOQ &amp; Project Charter)</div>
                                        <div style="font-size: 18px; font-weight: bold;" t-out="o.project_name"/>
                                        <div style="font-size: 11px; margin-top: 4px;">
                                            المرجع: <strong t-out="o.name"/>
                                            <t t-if="o.location"> | الموقع: <span t-out="o.location"/></t>
                                        </div>
                                    </td>
                                    <td style="width: 30%; text-align: left; vertical-align: middle;">
                                        <div style="background: #1e3a5f; padding: 6px 10px; border-radius: 4px; display: inline-block; text-align: center;">
                                            <div style="font-size: 10px; color: #cbd5e1;">نوع المشروع / الحالة</div>
                                            <div style="font-size: 12px; font-weight: bold; color: #f8fafc;">
                                                <span t-field="o.project_type"/> — <span t-field="o.state"/>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Early Cost Alert -->
                        <t t-if="o.is_early_cost_alert">
                            <div style="background: #fee2e2; border: 1px solid #dc2626; color: #991b1b; padding: 8px 12px; border-radius: 4px; margin-bottom: 12px;">
                                <strong>تنبيه تكلفة مبكر:</strong>
                                نسبة الإنجاز (<t t-out="'%.1f' % o.progress_percent"/>%) مقابل نسبة الصرف (<t t-out="'%.1f' % o.cost_burn_percent"/>%) تستدعي المراجعة المالية الفورية.
                            </div>
                        </t>
                        <t t-elif="o.is_over_budget">
                            <div style="background: #fef3c7; border: 1px solid #d97706; color: #92400e; padding: 8px 12px; border-radius: 4px; margin-bottom: 12px;">
                                <strong>تنبيه ميزانية:</strong>
                                التكلفة النهائية المتوقعة (EAC) تتجاوز الميزانية المخططة بمقدار
                                <span t-field="o.budget_variance" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>.
                            </div>
                        </t>

                        <!-- Section 1: Schedule & Delay + 8 Specs -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
                            <tr>
                                <td style="width: 50%; vertical-align: top; padding-left: 6px;">
                                    <div style="font-size: 12px; font-weight: bold; color: #0f2942; border-bottom: 2px solid #c99738; padding-bottom: 3px; margin-bottom: 6px;">
                                        الجدول الزمني والتأخير
                                    </div>
                                    <table style="width: 100%; border-collapse: collapse; border: 1px solid #cbd5e1;">
                                        <tr style="background: #f8fafc;">
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1; width: 45%;">البداية (المخطط / الفعلي)</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">
                                                <span t-field="o.date_start_planned"/> / <span t-field="o.date_start_actual"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">النهاية (المخطط / المتوقع)</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">
                                                <span t-field="o.date_end_planned"/> / <span t-field="o.date_end_expected"/>
                                            </td>
                                        </tr>
                                        <tr style="background: #f8fafc;">
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">أيام التأخير</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">
                                                <strong t-out="o.delay_days"/> يوم
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">سبب التأخير</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;" t-out="o.delay_reason or 'لا يوجد'"/>
                                        </tr>
                                    </table>
                                </td>
                                <td style="width: 50%; vertical-align: top; padding-right: 6px;">
                                    <div style="font-size: 12px; font-weight: bold; color: #0f2942; border-bottom: 2px solid #c99738; padding-bottom: 3px; margin-bottom: 6px;">
                                        وصف المشروع (المواصفات الفنية الـ 8)
                                    </div>
                                    <table style="width: 100%; border-collapse: collapse; border: 1px solid #cbd5e1;">
                                        <tr style="background: #f8fafc;">
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">مساحة الأرض</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;"><span t-out="o.land_area"/> م²</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">عدد الأدوار</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;" t-out="o.floors_count"/>
                                        </tr>
                                        <tr>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">مساحة المبنى</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;"><span t-out="o.building_area"/> م²</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">الوحدات السكنية</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;" t-out="o.residential_units_count"/>
                                        </tr>
                                        <tr style="background: #f8fafc;">
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">إجمالي المسطحات</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;"><span t-out="o.total_built_area"/> م²</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">المحلات التجارية</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;" t-out="o.commercial_shops_count"/>
                                        </tr>
                                        <tr>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">مواقف السيارات</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;" t-out="o.parking_slots_count"/>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">عدادات الكهرباء</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;" t-out="o.electricity_meters_count"/>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- Section 2: Parties & Crew -->
                        <div style="font-size: 12px; font-weight: bold; color: #0f2942; border-bottom: 2px solid #c99738; padding-bottom: 3px; margin-bottom: 6px;">
                            أطراف المشروع والطاقم والمعدات
                        </div>
                        <table style="width: 100%; border-collapse: collapse; border: 1px solid #cbd5e1; margin-bottom: 12px;">
                            <tr style="background: #f8fafc;">
                                <td style="padding: 4px 6px; border: 1px solid #cbd5e1; width: 16%;"><strong>المالك:</strong></td>
                                <td style="padding: 4px 6px; border: 1px solid #cbd5e1; width: 34%;" t-out="o.owner_id.name or '-'"/>
                                <td style="padding: 4px 6px; border: 1px solid #cbd5e1; width: 16%;"><strong>مدير المشروع:</strong></td>
                                <td style="padding: 4px 6px; border: 1px solid #cbd5e1; width: 34%;" t-out="o.project_manager_id.name or '-'"/>
                            </tr>
                            <tr>
                                <td style="padding: 4px 6px; border: 1px solid #cbd5e1;"><strong>الاستشاري:</strong></td>
                                <td style="padding: 4px 6px; border: 1px solid #cbd5e1;" t-out="o.consultant_id.name or '-'"/>
                                <td style="padding: 4px 6px; border: 1px solid #cbd5e1;"><strong>مهندس المشروع:</strong></td>
                                <td style="padding: 4px 6px; border: 1px solid #cbd5e1;" t-out="o.project_engineer_id.name or '-'"/>
                            </tr>
                            <tr style="background: #f8fafc;">
                                <td style="padding: 4px 6px; border: 1px solid #cbd5e1;"><strong>المصمم / التأمين:</strong></td>
                                <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">
                                    <span t-out="o.designer_id.name or '-'"/> / <span t-out="o.insurance_company_id.name or '-'"/>
                                </td>
                                <td style="padding: 4px 6px; border: 1px solid #cbd5e1;"><strong>الفنيون والعمال:</strong></td>
                                <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">
                                    <span t-out="o.technicians_count"/> فني | <span t-out="o.workers_count"/> عامل
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 4px 6px; border: 1px solid #cbd5e1;"><strong>الجهات الرسمية:</strong></td>
                                <td style="padding: 4px 6px; border: 1px solid #cbd5e1;" t-out="o.official_authority_id.name or '-'"/>
                                <td style="padding: 4px 6px; border: 1px solid #cbd5e1;"><strong>المعدات بالموقع:</strong></td>
                                <td style="padding: 4px 6px; border: 1px solid #cbd5e1;" t-out="o.equipment_summary or '-'"/>
                            </tr>
                        </table>

                        <!-- Section 3: BOQ Lines Table -->
                        <div style="font-size: 12px; font-weight: bold; color: #0f2942; border-bottom: 2px solid #c99738; padding-bottom: 3px; margin-bottom: 6px;">
                            جدول بنود المقايسة والتكاليف (BOQ)
                        </div>
                        <table style="width: 100%; border-collapse: collapse; border: 1px solid #cbd5e1; margin-bottom: 12px; font-size: 10px;">
                            <thead>
                                <tr style="background: #0f2942; color: #ffffff;">
                                    <th style="padding: 5px 4px; border: 1px solid #334155; text-align: center;">#</th>
                                    <th style="padding: 5px 6px; border: 1px solid #334155; text-align: right;">البند</th>
                                    <th style="padding: 5px 4px; border: 1px solid #334155; text-align: center;">الوحدة</th>
                                    <th style="padding: 5px 4px; border: 1px solid #334155; text-align: left;">الكمية</th>
                                    <th style="padding: 5px 4px; border: 1px solid #334155; text-align: left;">السعر</th>
                                    <th style="padding: 5px 4px; border: 1px solid #334155; text-align: left;">المخطط</th>
                                    <th style="padding: 5px 4px; border: 1px solid #334155; text-align: left;">الفعلي</th>
                                    <th style="padding: 5px 4px; border: 1px solid #334155; text-align: left;">الإكمال ETC</th>
                                    <th style="padding: 5px 4px; border: 1px solid #334155; text-align: left;">النهائية EAC</th>
                                    <th style="padding: 5px 4px; border: 1px solid #334155; text-align: left;">الانحراف</th>
                                    <th style="padding: 5px 4px; border: 1px solid #334155; text-align: center;">الإنجاز %</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="idx" t-value="0"/>
                                <t t-foreach="o.line_ids.filtered('included')" t-as="line">
                                    <t t-set="idx" t-value="idx + 1"/>
                                    <tr t-att-style="'background: #f8fafc;' if idx % 2 == 0 else ''">
                                        <td style="padding: 4px; border: 1px solid #cbd5e1; text-align: center;" t-out="idx"/>
                                        <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">
                                            <span t-out="line.name"/>
                                            <t t-if="line.is_variation_order">
                                                <span style="background: #dbeafe; color: #1e40af; padding: 1px 4px; border-radius: 3px; font-size: 9px;">أمر تغييري</span>
                                            </t>
                                        </td>
                                        <td style="padding: 4px; border: 1px solid #cbd5e1; text-align: center;" t-out="line.uom_name"/>
                                        <td style="padding: 4px; border: 1px solid #cbd5e1; text-align: left;" t-out="'{:,.2f}'.format(line.planned_qty)"/>
                                        <td style="padding: 4px; border: 1px solid #cbd5e1; text-align: left;" t-out="'{:,.2f}'.format(line.unit_price)"/>
                                        <td style="padding: 4px; border: 1px solid #cbd5e1; text-align: left;" t-out="'{:,.2f}'.format(line.planned_amount)"/>
                                        <td style="padding: 4px; border: 1px solid #cbd5e1; text-align: left;" t-out="'{:,.2f}'.format(line.actual_amount)"/>
                                        <td style="padding: 4px; border: 1px solid #cbd5e1; text-align: left;" t-out="'{:,.2f}'.format(line.etc_amount)"/>
                                        <td style="padding: 4px; border: 1px solid #cbd5e1; text-align: left;" t-out="'{:,.2f}'.format(line.eac_amount)"/>
                                        <td style="padding: 4px; border: 1px solid #cbd5e1; text-align: left;" t-out="'{:,.2f}'.format(line.variance_amount)"/>
                                        <td style="padding: 4px; border: 1px solid #cbd5e1; text-align: center;" t-out="('%.1f' % line.progress_percent) + '%'"/>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background: #e2e8f0; font-weight: bold;">
                                    <td colspan="5" style="padding: 5px 6px; border: 1px solid #94a3b8;">الإجمالي الكلي للمقايسة (<span t-out="o.currency_id.name"/>)</td>
                                    <td style="padding: 5px 4px; border: 1px solid #94a3b8; text-align: left;" t-out="'{:,.2f}'.format(o.total_planned)"/>
                                    <td style="padding: 5px 4px; border: 1px solid #94a3b8; text-align: left;" t-out="'{:,.2f}'.format(o.total_actual)"/>
                                    <td style="padding: 5px 4px; border: 1px solid #94a3b8; text-align: left;" t-out="'{:,.2f}'.format(o.total_etc)"/>
                                    <td style="padding: 5px 4px; border: 1px solid #94a3b8; text-align: left;" t-out="'{:,.2f}'.format(o.total_eac)"/>
                                    <td style="padding: 5px 4px; border: 1px solid #94a3b8; text-align: left;" t-out="'{:,.2f}'.format(o.budget_variance)"/>
                                    <td style="padding: 5px 4px; border: 1px solid #94a3b8; text-align: center;" t-out="('%.1f' % o.progress_percent) + '%'"/>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Section 4: Financial Summary + Document Compliance -->
                        <table style="width: 100%; border-collapse: collapse;">
                            <tr>
                                <td style="width: 55%; vertical-align: top; padding-left: 6px;">
                                    <div style="font-size: 12px; font-weight: bold; color: #0f2942; border-bottom: 2px solid #c99738; padding-bottom: 3px; margin-bottom: 6px;">
                                        الملخص المالي للمشروع
                                    </div>
                                    <table style="width: 100%; border-collapse: collapse; border: 1px solid #cbd5e1;">
                                        <tr style="background: #f8fafc;">
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">إجمالي الميزانية المخططة</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1; text-align: left;"><span t-field="o.total_planned" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">المنصرف الفعلي + الالتزامات</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1; text-align: left;">
                                                <span t-field="o.total_actual" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                + <span t-field="o.total_committed" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                        </tr>
                                        <tr style="background: #f8fafc;">
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">التكلفة النهائية المتوقعة (EAC)</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1; text-align: left;"><strong t-field="o.total_eac" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">نسبة الصرف مقابل الإنجاز</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1; text-align: left;">
                                                صرف <strong t-out="('%.1f' % o.cost_burn_percent) + '%'"/> | إنجاز <strong t-out="('%.1f' % o.progress_percent) + '%'"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                                <td style="width: 45%; vertical-align: top; padding-right: 6px;">
                                    <div style="font-size: 12px; font-weight: bold; color: #0f2942; border-bottom: 2px solid #c99738; padding-bottom: 3px; margin-bottom: 6px;">
                                        حالة المستندات والمرفقات الرسمية
                                    </div>
                                    <table style="width: 100%; border-collapse: collapse; border: 1px solid #cbd5e1;">
                                        <tr style="background: #f8fafc;">
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">إجمالي المستندات</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1; text-align: center;" t-out="o.docs_total_count"/>
                                        </tr>
                                        <tr>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">المرفقة / المعتمدة</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1; text-align: center; color: #15803d;"><strong t-out="o.docs_uploaded_count"/></td>
                                        </tr>
                                        <tr style="background: #f8fafc;">
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1;">المطلوبة (قيد الاستكمال)</td>
                                            <td style="padding: 4px 6px; border: 1px solid #cbd5e1; text-align: center; color: #b45309;"><strong t-out="o.docs_pending_count"/></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
